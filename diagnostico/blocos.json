  "blocks": [
    {
      "id": "B-CRT-01",
      "fam": "criativo",
      "name": "Criativo de Vídeo",
      "bottleneck": true,
      "deliv": "1 anúncio em vídeo, 2 formatos (4×5 e 9×16), renomeado no padrão",
      "params": [
        "tipo: novo ad | novo hook | reels",
        "origem: gravação | banco | IA",
        "com copy? sim/não"
      ],
      "input": "Brief de ângulo/hook + (se aplicável) copy aprovada",
      "output": "Vídeo editado pronto pra subir",
      "role": "Copy + Gravação + Editor",
      "reuse": [
        "Remessa",
        "Lançamento",
        "CDV",
        "Meteórico"
      ],
      "tasks": [
        {
          "t": "Escrever copy do criativo",
          "d": "Doc de copy, sem info errada, link no comentário",
          "bot": true
        },
        {
          "t": "Gravar (expert ou banco)",
          "d": "Takes brutos de todos os ângulos no Drive"
        },
        {
          "t": "Editar",
          "d": "4×5 + 9×16, recursos nativos CapCut/TikTok, sem-hook 1º"
        },
        {
          "t": "Revisar (condicional)",
          "d": "Aprovado pelo Head de Edição",
          "cond": true
        },
        {
          "t": "Renomear no padrão",
          "d": "[hook][versão]-[editor]-[copy]-[funil]-[remessa]-[projeto]-ON"
        }
      ],
      "dod": "Vídeo nos 2 formatos, renomeado, aprovado, linkado"
    },
    {
